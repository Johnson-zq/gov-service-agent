APP_ENV=LOCAL
LOG_LEVEL=INFO

# Docker Compose initialization (not Application Settings fields)
POSTGRES_DB=gov_service_agent
POSTGRES_USER=govagent
POSTGRES_PASSWORD=change_me_local_only

# Application runtime DB contract (Optional — omit or leave empty for Local-First)
DATABASE_URL=postgresql+psycopg://govagent:change_me_local_only@localhost:5432/gov_service_agent

# Integration tests only — set in process env for pytest -m integration (not a Settings field)
TEST_DATABASE_URL=postgresql+psycopg://govagent:change_me_local_only@localhost:5432/gov_service_agent_test
